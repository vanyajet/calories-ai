{
  "expo": {
    "name": "Calories AI",
    "slug": "calories-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "caloriesai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.vj.caloriesai",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Calories AI uses speech recognition to turn your voice into text.",
        "NSMicrophoneUsageDescription": "Calories AI uses the microphone so you can dictate what you ate."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.vj.caloriesai",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Calories AI uses the camera to photograph your meals.",
          "photosPermission": "Calories AI needs access to photos of your meals."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Calories AI uses the microphone so you can dictate what you ate.",
          "speechRecognitionPermission": "Calories AI uses speech recognition to turn your voice into text.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f53356ec-6e2f-4c82-b214-ed1af07ea5b4"
      }
    },
    "owner": "vanyajets-team"
  }
}
