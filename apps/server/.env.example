GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Used when the main model is overloaded or slower than GEMINI_TIMEOUT_MS
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=30000
# Any long random string; the same value goes to the app as EXPO_PUBLIC_APP_SECRET
APP_SECRET=
PORT=8787
# Only for docker compose --profile https
DOMAIN=
